{
  "name": "ningjing-personal-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,admin,api -c blue,cyan,green \"npm:dev:web\" \"npm:dev:admin\" \"npm:dev:server\"",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:admin": "vite --config admin/vite.config.ts",
    "dev:client": "npm run dev:web",
    "dev:server": "tsx watch server/index.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && npm run build:web && npm run build:admin",
    "build:web": "vite build --config web/vite.config.ts",
    "build:admin": "vite build --config admin/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts --host 0.0.0.0",
    "start": "tsx server/index.ts",
    "db:setup": "tsx server/setup.ts",
    "test": "playwright test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "lucide-vue-next": "^0.468.0",
    "mysql2": "^3.14.3",
    "multer": "^2.0.2",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.17.0",
    "@types/multer": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.0",
    "sass": "^1.90.0",
    "tsx": "^4.20.4",
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "vue-tsc": "^3.0.5"
  }
}
